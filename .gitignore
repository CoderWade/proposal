# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Downloaded source repositories
.cache/

# Pipeline intermediates are rebuilt from the official repos on every run.
data/proposals_raw.json
data/proposals.json
data/meta.json

# Translation cache (data/cache/translations.json) IS committed on purpose:
# it keeps the scheduled sync cheap and avoids re-translating everything
# when GitHub Actions caches are evicted.
data/cache/*.tmp

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Site build output (regenerated by CI, shipped via the Pages artifact)
site/data/
